# 环境变量配置文件示例
# 复制此文件为 .env 并填入你的实际密钥

# ============ LLM API 配置 ============
LLM_API_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2/chat/completions

# 主模型（DeepSeek V4 Flash）
LLM_MAIN_MODEL_ID=xopdeepseekv4flash
LLM_MAIN_API_KEY=your-main-api-key-here

# 快速模型（Qwen 4B）
LLM_FAST_MODEL_ID=xop3qwen4b
LLM_FAST_API_KEY=your-fast-api-key-here

# ============ 记忆系统配置 ============
MEMORY_API_URL=http://your-memosyne-host:port
MEMORY_APP_ID=your-app-id
MEMORY_REPO_ID=your-repo-id
MEMORY_AGENT_ID=decision_agent
